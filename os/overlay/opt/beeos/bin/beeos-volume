#!/bin/sh
# Ses tuşları: arka uç sesi değiştirir ve ekranda ses göstergesini çizer (volup | voldown | mute).
# Arka uca bağlanılamazsa ses yine de değişsin.
curl -fs -m 3 -o /dev/null -X POST -H 'X-BeeOS: 1' -H 'Content-Type: application/json' \
  -d "{\"action\":\"$1\"}" http://127.0.0.1:8080/api/volume
[ $? -eq 7 ] || exit 0
case "$1" in
  volup) wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
  voldown) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
  mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
esac
