{
  "root": true,
  "parserOptions": {
    "ecmaVersion": 5,
    "sourceType": "script"
  },
  "env": {
    "browser": true
  },
  "rules": {
    "no-var": "off",
    "prefer-const": "off",
    "prefer-arrow-callback": "off",
    "no-redeclare": "off"
  },
  "overrides": [
    {
      "files": ["tests/run.js", "tests/*.js"],
      "parserOptions": { "ecmaVersion": 2022, "sourceType": "script" },
      "env": { "node": true, "browser": false }
    },
    {
      "files": ["js/epg.js"],
      "env": { "browser": true, "commonjs": true }
    }
  ]
}
