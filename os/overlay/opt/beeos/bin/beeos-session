#!/bin/sh
# tty1'de otomatik girişten sonra çalışır ve sway'i (kiosk) başlatır.
# sway hemen kapanırsa (ekran kartı sorunu) sadece dahili Intel kartıyla tekrar dener.
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sway
# Sanal makine / sürücüsüz sistemlerde yazılımsal çizim
export WLR_RENDERER_ALLOW_SOFTWARE=1
export WLR_NO_HARDWARE_CURSORS=1
RUN=/run/user/$(id -u)

# Normalde sadece günlüğe yazar: açılış ekranının (plymouth) son karesi sway gelene kadar ekranda kalır.
# Ekran hiç açılamazsa shout() konsola da yazar.
say() { echo "$(date +%T) $*" >> "$RUN/session.log"; }
shout() { printf '\033[1;33mbeeOS:\033[0m %s\n' "$*"; say "$*"; }

# Dahili ekranı süren kart (boot_vga=1, genelde Intel)
primary_card() {
  for c in /sys/class/drm/card[0-9]; do
    [ "$(cat "$c/device/boot_vga" 2>/dev/null)" = 1 ] && { echo "/dev/dri/$(basename "$c")"; return; }
  done
}

try_sway() {
  say "sway başlatılıyor ($1)"
  start=$(date +%s)
  sway -c /opt/beeos/sway/config > "$RUN/sway-$1.log" 2>&1
  code=$?
  say "sway kapandı ($1), kod $code, $(( $(date +%s) - start )) sn"
  # 20 sn'den uzun çalıştıysa bilerek kapatılmıştır (Ctrl+Alt+Backspace vb.)
  [ $(( $(date +%s) - start )) -gt 20 ]
}

# Harici ekran (TV) dahili karttan başka bir karta (laptopta Nvidia) bağlı mı?
external_on_other_card() {
  for st in /sys/class/drm/card[0-9]-HDMI-A-*/status /sys/class/drm/card[0-9]-DP-*/status; do
    [ -f "$st" ] && [ "$(cat "$st")" = connected ] || continue
    c=$(basename "$(dirname "$st")" | cut -d- -f1)
    [ "/dev/dri/$c" != "$1" ] && return 0
  done
  return 1
}

card=$(primary_card)
# Normalde sadece dahili kart (Intel): Nvidia sürücüsü (nouveau) yavaş açılıp takılabiliyor.
# TV Nvidia'ya bağlı HDMI'dan takılıysa iki kart birlikte denenir.
if [ -n "$card" ] && external_on_other_card "$card"; then
  try_sway tum-kartlar && exit 0
fi
if [ -n "$card" ]; then
  export WLR_DRM_DEVICES="$card"
  try_sway "sadece-$(basename "$card")" && exit 0
  unset WLR_DRM_DEVICES
fi
try_sway tum-kartlar && exit 0
export WLR_RENDERER=pixman
try_sway yazilimsal && exit 0

shout "Ekran başlatılamadı. Günlükler flash diskteki BEEOS-LOG bölümüne yazıldı."
shout "Bilgisayarı kapatmak için güç tuşuna bas."
sleep 600
