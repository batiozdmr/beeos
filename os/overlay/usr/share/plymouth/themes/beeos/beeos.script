// beeOS açılış ekranı: arayüzdeki açılış animasyonuyla aynı zemin, ortada petek logosu,
// altında "beeOS" yazısı. Logo yavaşça nefes alır (sadece saydamlık değişir).
// logo.png: tools/make_icons.py üretir.

Window.SetBackgroundTopColor(0.027, 0.035, 0.059);
Window.SetBackgroundBottomColor(0.027, 0.035, 0.059);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 1);

name.image = Image.Text("beeOS", 1, 1, 1, 0.85, "Sans 40");
name.sprite = Sprite(name.image);
name.x = Window.GetX() + Window.GetWidth() / 2 - name.image.GetWidth() / 2;
name.sprite.SetPosition(name.x, logo.y + logo.image.GetHeight() + 36, 1);

t = 0;
fun refresh_callback () {
  t++;
  logo.sprite.SetOpacity(0.7 + 0.3 * Math.Sin(t / 30));
}
Plymouth.SetRefreshFunction(refresh_callback);
