{
  "compilerOptions": {
    "target": "es5",
    "module": "none",
    "lib": ["es5", "dom"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": true,
    "alwaysStrict": false,
    "noUnusedLocals": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["js/**/*.js", "types/**/*.d.ts"],
  "exclude": ["js/vendor/**", "js/logos.js", "node_modules"]
}
